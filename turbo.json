{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:watch": {
      "persistent": true,
      "cache": false
    },
    "check": {
      "dependsOn": ["transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**/*"]
    },
    "serve": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULTS$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULTS$", "$TURBO_ROOT$/.oxlintrc.json"],
      "cache": false
    },

    "//#oxfmt:check": {},
    "//#oxfmt": {
      "cache": false
    },
    "//#knip:check": {},

    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
