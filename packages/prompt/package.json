{
  "name": "@convoker/prompt",
  "type": "module",
  "version": "0.4.0",
  "description": "A simple, type-safe CLI prompting library.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprucepad/convoker"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": {
        "import": "./dist/core/index.d.mts",
        "require": "./dist/core/index.d.cts"
      },
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "check": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "convoker",
    "prompt"
  ],
  "dependencies": {
    "@convoker/theme": "workspace:^",
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@convoker/theme": "workspace:^"
  },
  "devDependencies": {
    "@dev/configs": "workspace:*",
    "@types/node": "~22.15.27",
    "eslint": "^10.2.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@convoker/theme": {
      "optional": true
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
