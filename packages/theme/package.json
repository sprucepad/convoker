{
  "name": "@convoker/theme",
  "type": "module",
  "version": "0.2.0",
  "description": "A simple CLI theming library.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprucepad/convoker"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./global": {
      "types": {
        "import": "./dist/global.d.mts",
        "require": "./dist/global.d.cts"
      },
      "import": "./dist/global.mjs",
      "require": "./dist/global.cjs"
    },
    "./utils": {
      "types": {
        "import": "./dist/utils.d.mts",
        "require": "./dist/utils.d.cts"
      },
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs"
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "check": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "convoker",
    "theme",
    "theming"
  ],
  "files": [
    "src",
    "dist"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@dev/configs": "workspace:*",
    "@types/node": "~22.15.27",
    "eslint": "^10.2.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  }
}
