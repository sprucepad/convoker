{
  "name": "convoker",
  "type": "module",
  "version": "0.7.0",
  "description": "A simple, type-safe CLI framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprucepad/convoker"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./log": {
      "types": {
        "import": "./dist/log.d.mts",
        "require": "./dist/log.d.cts"
      },
      "import": "./dist/log.mjs",
      "require": "./dist/log.cjs"
    },
    "./prompt": {
      "types": {
        "import": "./dist/prompt/index.d.mts",
        "require": "./dist/prompt/index.d.cts"
      },
      "import": "./dist/prompt/index.mjs",
      "require": "./dist/prompt/index.cjs"
    },
    "./prompt/core": {
      "types": {
        "import": "./dist/prompt/core.d.mts",
        "require": "./dist/prompt/core.d.cts"
      },
      "import": "./dist/prompt/core.mjs",
      "require": "./dist/prompt/core.cjs"
    },
    "./theme": {
      "types": {
        "import": "./dist/theme/index.d.mts",
        "require": "./dist/theme/index.d.cts"
      },
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.cjs"
    },
    "./theme/global": {
      "types": {
        "import": "./dist/theme/global.d.mts",
        "require": "./dist/theme/global.d.cts"
      },
      "import": "./dist/theme/global.mjs",
      "require": "./dist/theme/global.cjs"
    },
    "./theme/utils": {
      "types": {
        "import": "./dist/theme/utils.d.mts",
        "require": "./dist/theme/utils.d.cts"
      },
      "import": "./dist/theme/utils.mjs",
      "require": "./dist/theme/utils.cjs"
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "check": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "cli",
    "command",
    "args",
    "argv",
    "option",
    "prompt",
    "log",
    "theme"
  ],
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@convoker/core": "workspace:^",
    "@convoker/log": "workspace:^",
    "@convoker/prompt": "workspace:^",
    "@convoker/theme": "workspace:^"
  },
  "devDependencies": {
    "@dev/configs": "workspace:*",
    "@types/node": "~22.15.27",
    "eslint": "^10.2.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sprucepad",
  "license": "MIT",
  "peerDependencies": {
    "@convoker/core": "workspace:^",
    "@convoker/log": "workspace:^",
    "@convoker/prompt": "workspace:^",
    "@convoker/theme": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@convoker/core": {
      "optional": true
    },
    "@convoker/log": {
      "optional": true
    },
    "@convoker/prompt": {
      "optional": true
    },
    "@convoker/theme": {
      "optional": true
    }
  }
}
