{
  "name": "@convoker/core",
  "version": "0.4.0",
  "description": "A simple, type-safe CLI argument parser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprucepad/convoker"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "tsdown",
    "check": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "cli",
    "command",
    "args",
    "argv",
    "option"
  ],
  "author": "sprucepad",
  "license": "MIT",
  "dependencies": {
    "@convoker/theme": "workspace:^",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@dev/configs": "workspace:*",
    "@types/node": "~22.15.27",
    "eslint": "^10.2.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "valibot": "^1.3.1"
  },
  "peerDependencies": {
    "@convoker/log": "workspace:^",
    "@convoker/prompt": "workspace:^",
    "@convoker/theme": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@convoker/log": {
      "optional": true
    },
    "@convoker/prompt": {
      "optional": true
    },
    "@convoker/theme": {
      "optional": true
    },
    "@convoker/input": {
      "optional": true
    }
  }
}
